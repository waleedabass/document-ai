// Back-Office Document AI — data model
// SQLite for local dev via a driver adapter (Prisma 7 requires one explicitly).
// No native enum on sqlite, so status/type fields are String, validated at
// the application layer — see src/lib/enums.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Document {
  id        String   @id @default(cuid())
  filename  String
  filePath  String   // legacy unique-name identifier, kept for audit — no longer a disk path
  fileData  Bytes    // the original uploaded file, stored in the DB since the deployed
                     // runtime has no persistent disk to keep it on
  mimeType  String
  status    String   @default("processing") // "processing" | "needs_review" | "approved" | "exported" | "failed"
  model     String?  // which AI provider/model extracted this
  createdAt DateTime @default(now())

  fields     ExtractedField[]
  lineItems  LineItem[]
  exports    ExportRecord[]

  @@index([status])
}

model ExtractedField {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id])

  fieldName     String   // "vendor" | "invoiceNumber" | "invoiceDate" | "dueDate" | "subtotal" | "tax" | "total"
  value         String
  confidence    Int      // 0-100, model-reported
  status        String   @default("ok") // "ok" | "needs_review" | "corrected"
  correctedValue String?
  warning       String?  // set by a validation rule, independent of model confidence
  createdAt     DateTime @default(now())

  @@index([documentId])
}

model LineItem {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])

  description String
  quantity    Float
  unitPrice   Float
  total       Float
  confidence  Int

  @@index([documentId])
}

model ExportRecord {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])

  provider   String   // "quickbooks" | "xero" | "log_only"
  externalId String?
  status     String   @default("exported") // "exported" | "failed"
  createdAt  DateTime @default(now())

  @@index([documentId])
}

model Proposal {
  id          String   @id @default(cuid())
  clientName  String
  projectTitle String
  inputBrief  String   // the pasted transcript/notes
  sections    String   // JSON-encoded [{heading, body}]
  lineItems   String   // JSON-encoded [{description, price}]
  totalPrice  Float
  model       String
  pdfPath     String?
  pdfData     Bytes?
  createdAt   DateTime @default(now())
}
